Sounds/
**/Sounds/
library.json
settings.json
*.corrupt
*.tmp

# Block personal audio formats anywhere in the repo (test fixtures are
# explicitly re-included below because they are synthetic, generated tones).
*.mp3
*.wav
*.ogg
*.flac
*.m4a
*.aac
*.wma
*.opus
!tests/KayoneZSoundpad.Tests/TestAssets/*.mp3
!tests/KayoneZSoundpad.Tests/TestAssets/*.ogg
!tests/KayoneZSoundpad.Tests/TestAssets/*.flac
