<Window x:Class="KayoneZSoundpad.Views.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KayoneZSoundpad.Views"
        Title="Voxora Radial"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" ResizeMode="NoResize"
        FontFamily="{DynamicResource Font.Body}">

    <Canvas x:Name="Root" Background="#6B060504">
        <views:RadialMenuControl x:Name="Ring" Width="560" Height="560"/>
    </Canvas>
</Window>
