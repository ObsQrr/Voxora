<Window x:Class="KayoneZSoundpad.Views.CableGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Guide_Title}" Width="720" Height="640"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Bg}"
        WindowStyle="ToolWindow" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial" FontSize="13">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="18,14">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="{DynamicResource Settings_AutoSetup}" Padding="16,8"
                            Style="{StaticResource AccentButton}" Click="AutoConfig_Click"
                            AutomationProperties.Name="{DynamicResource Settings_AutoSetupAutomation}"/>
                </StackPanel>
                <Button Content="{DynamicResource Common_Close}" IsCancel="True" MinWidth="100" Padding="16,8"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="{DynamicResource Common_Close}"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <Border Width="56" Height="56" CornerRadius="12" Background="{DynamicResource Brush.Accent}">
                        <TextBlock Text="&#xE720;" Style="{StaticResource Icon}" FontSize="28"
                                   Foreground="{DynamicResource Brush.OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Guide_Title}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <TextBlock Text="{DynamicResource Guide_Subtitle}" FontSize="12.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- ADIM 1 -->
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Divider}"
                        BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Guide_Step1}" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource Guide_Step1Body}" TextWrapping="Wrap" LineHeight="22"
                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <Button Content="{DynamicResource Guide_OpenDownload}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Padding="14,7" Click="DownloadCable_Click"
                                AutomationProperties.Name="{DynamicResource Guide_DownloadAutomation}"/>
                    </StackPanel>
                </Border>

                <!-- ADIM 2 -->
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Divider}"
                        BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Guide_Step2}" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="SetOutputText" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock x:Name="SetInputText" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <Button Content="{DynamicResource Guide_OpenSoundSettings}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Padding="14,7" Click="OpenSoundSettings_Click"
                                AutomationProperties.Name="{DynamicResource Guide_OpenSoundSettingsAutomation}"/>
                    </StackPanel>
                </Border>

                <!-- ADIM 3 -->
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Divider}"
                        BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Guide_Step3}" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource Guide_Step3Body}" TextWrapping="Wrap" LineHeight="22"
                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource Guide_AutoNote}" TextWrapping="Wrap" LineHeight="20"
                           FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="2,0,2,8"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
