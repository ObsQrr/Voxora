<UserControl x:Class="KayoneZSoundpad.Views.HotkeyBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             FocusVisualStyle="{x:Null}">
    <Border Background="{DynamicResource Brush.Input}" BorderBrush="{DynamicResource Brush.InputBorder}"
            BorderThickness="1" CornerRadius="8" Padding="10,7" MinHeight="34" x:Name="Bd">
        <TextBlock x:Name="Display" Text="{DynamicResource Hotkey_Hint}"
                   Foreground="{DynamicResource Brush.TextMuted}" FontSize="12.5"
                   VerticalAlignment="Center"/>
    </Border>
</UserControl>
