<Window x:Class="KayoneZSoundpad.Views.EditSoundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KayoneZSoundpad.Views"
        Title="Sesi Düzenle" Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg}" WindowStyle="ToolWindow"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial" FontSize="13.5"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,7,10,7"/>
                </Style>
            </Grid.Resources>

            <TextBlock Text="Ad"/>
            <TextBox x:Name="NameBox" Grid.Column="1"/>

            <TextBlock Text="Kategori" Grid.Row="1"/>
            <ComboBox x:Name="CategoryCombo" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Name"/>

            <TextBlock Text="İkon" Grid.Row="2"/>
            <ComboBox x:Name="IconCombo" Grid.Row="2" Grid.Column="1" MaxWidth="200" HorizontalAlignment="Left"/>

            <TextBlock Text="Renk" Grid.Row="3"/>
            <StackPanel x:Name="ColorPanel" Grid.Row="3" Grid.Column="1" Orientation="Horizontal"/>

            <TextBlock Text="Ses seviyesi" Grid.Row="4"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Slider x:Name="VolumeSlider" Width="200" Minimum="0" Maximum="1.5" Value="1"/>
                <TextBlock x:Name="VolumeLabel" Style="{StaticResource Muted}" Margin="10,0,0,0" Text="100%"/>
            </StackPanel>

            <TextBlock Text="Tekrar basınca" Grid.Row="5"/>
            <ComboBox x:Name="BehaviorCombo" Grid.Row="5" Grid.Column="1" MaxWidth="220" HorizontalAlignment="Left"
                      SelectedIndex="0">
                <ComboBoxItem Content="Yeniden başlat"/>
                <ComboBoxItem Content="Üstüne çal"/>
                <ComboBoxItem Content="Çalıyorsa durdur"/>
            </ComboBox>

            <TextBlock Text="Kısayol" Grid.Row="6"/>
            <StackPanel Grid.Row="6" Grid.Column="1">
                <views:HotkeyBox x:Name="HotkeyBoxCtl"/>
                <TextBlock x:Name="ConflictText" Foreground="{DynamicResource Brush.Danger}" FontSize="11.5"
                           TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                <CheckBox x:Name="HoldCheck" Content="Basılı tutunca çal (tuş bırakınca dursun)" VerticalAlignment="Center"/>
                <CheckBox x:Name="FavCheck" Content="Favori" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="İptal" IsCancel="True" MinWidth="86"/>
            <Button Content="Kaydet" MinWidth="86" Margin="8,0,0,0" Style="{StaticResource AccentButton}" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
