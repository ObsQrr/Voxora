<Window x:Class="KayoneZSoundpad.Views.EditSoundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KayoneZSoundpad.Views"
        Title="{DynamicResource Edit_Title}" Width="560" Height="540"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Bg}"
        WindowStyle="ToolWindow" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial" FontSize="13">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Common_Cancel}" IsCancel="True" MinWidth="92" Padding="14,8"
                        AutomationProperties.Name="{DynamicResource Common_Cancel}"/>
                <Button Content="{DynamicResource Common_Save}" MinWidth="92" Margin="10,0,0,0" Style="{StaticResource AccentButton}"
                        Click="Save_Click" Padding="14,8" AutomationProperties.Name="{DynamicResource Common_Save}"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18">
            <StackPanel>

                <!-- İsim -->
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="{DynamicResource Edit_Name}" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                    <TextBox x:Name="NameBox" MaxLength="200"
                             AutomationProperties.Name="{DynamicResource Edit_NameAutomation}"/>
                </StackPanel>

                <!-- Kategori -->
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="{DynamicResource Edit_Category}" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CategoryCombo" DisplayMemberPath="Name"
                              AutomationProperties.Name="{DynamicResource Edit_CategoryAutomation}"/>
                </StackPanel>

                <!-- İkon -->
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="{DynamicResource Edit_Icon}" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                    <TextBox x:Name="IconBox" MaxLength="8" FontSize="18" Padding="12,6"
                             AutomationProperties.Name="{DynamicResource Edit_IconAutomation}"/>
                    <TextBlock Text="{DynamicResource Edit_IconHint}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Ses Dosyası -->
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="{DynamicResource Edit_File}" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FilePathBox" IsReadOnly="True"
                                 AutomationProperties.Name="{DynamicResource Edit_FileAutomation}"/>
                        <Button Grid.Column="1" Content="{DynamicResource Edit_Change}" Margin="10,0,0,0" Padding="12,8"
                                Click="ChangeFile_Click" AutomationProperties.Name="{DynamicResource Edit_ChangeAutomation}"/>
                    </Grid>
                </StackPanel>

                <!-- Kısayol -->
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="{DynamicResource Edit_Hotkey}" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <views:HotkeyBox x:Name="HotkeyBox" Width="300"
                                         AutomationProperties.Name="{DynamicResource Edit_HotkeyAutomation}"/>
                        <Button Content="{DynamicResource Edit_Clear}" Margin="10,0,0,0" Padding="12,8"
                                Click="ClearHotkey_Click" AutomationProperties.Name="{DynamicResource Edit_ClearAutomation}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Ses Seviyesi -->
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="{DynamicResource Edit_Volume}" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1.5"
                            SmallChange="0.05" LargeChange="0.1"
                            AutomationProperties.Name="{DynamicResource Edit_VolumeAutomation}"/>
                </StackPanel>

                <!-- Seçenekler -->
                <StackPanel Margin="0,0,0,18">
                    <CheckBox x:Name="FavoriteCheck" Content="{DynamicResource Edit_Favorite}"
                              Margin="0,0,0,6"
                              AutomationProperties.Name="{DynamicResource Edit_FavoriteAutomation}"/>
                    <CheckBox x:Name="MutedCheck" Content="{DynamicResource Edit_Muted}"
                              Margin="0,0,0,6"
                              AutomationProperties.Name="{DynamicResource Edit_MutedAutomation}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
