<Window x:Class="KayoneZSoundpad.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KayoneZSoundpad.Views"
        Title="{DynamicResource Settings_Title}" Width="920" Height="780"
        MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg}" WindowStyle="ToolWindow"
        FontFamily="{DynamicResource Font.Body}" FontSize="13"
        ShowInTaskbar="False" UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <views:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <views:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis"/>
            <views:MuteIconConverter x:Key="MuteIconConverter"/>
            <views:MuteTipConverter x:Key="MuteTipConverter"/>

            <Style x:Key="SettingRowLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,18,0"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                <Setter Property="FontSize" Value="12.5"/>
            </Style>

            <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontFamily" Value="{DynamicResource Font.Display}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="CardHint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,3,0,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- ================= ALT EYLEM ÇUBUĞU ================= -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock Text="{DynamicResource Settings_SaveHint}" Style="{StaticResource SectionLabel}"
                           VerticalAlignment="Center" FontSize="9.5"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Common_Cancel}" IsCancel="True" MinWidth="110" Padding="16,8"
                            AutomationProperties.Name="{DynamicResource Common_Cancel}"/>
                    <Button Content="{DynamicResource Common_Save}" MinWidth="110" Margin="10,0,0,0"
                            Style="{StaticResource AccentButton}"
                            Click="Save_Click" Padding="16,8" AutomationProperties.Name="{DynamicResource Common_Save}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= SOL GEZİNME ================= -->
        <Border DockPanel.Dock="Left" Width="212" Background="{DynamicResource Brush.Rail}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="20,22,20,18">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Brush.Accent}">
                        <Grid>
                            <Rectangle Width="2.5" Height="9" RadiusX="1.25" Fill="{DynamicResource Brush.OnAccent}"
                                       HorizontalAlignment="Center" Margin="-7,0,0,0"/>
                            <Rectangle Width="2.5" Height="15" RadiusX="1.25" Fill="{DynamicResource Brush.OnAccent}"
                                       HorizontalAlignment="Center"/>
                            <Rectangle Width="2.5" Height="6" RadiusX="1.25" Fill="{DynamicResource Brush.OnAccent}"
                                       HorizontalAlignment="Center" Margin="7,0,0,0"/>
                        </Grid>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Settings_Title}" FontFamily="{DynamicResource Font.Display}"
                                   FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RailVersionText" Style="{StaticResource MonoValue}" FontSize="10"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="NavList" Grid.Row="1" Margin="10,0,10,0" SelectionChanged="Nav_SelectionChanged">
                    <ListBoxItem Tag="general" AutomationProperties.Name="{DynamicResource Settings_NavGeneral}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource IconSm}" Margin="2,0,10,0"/>
                            <TextBlock Text="{DynamicResource Settings_NavGeneral}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="audio" AutomationProperties.Name="{DynamicResource Settings_NavAudio}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE767;" Style="{StaticResource IconSm}" Margin="2,0,10,0"/>
                            <TextBlock Text="{DynamicResource Settings_NavAudio}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="behavior" AutomationProperties.Name="{DynamicResource Settings_NavBehavior}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C1;" Style="{StaticResource IconSm}" Margin="2,0,10,0"/>
                            <TextBlock Text="{DynamicResource Settings_NavBehavior}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="features" AutomationProperties.Name="{DynamicResource Settings_NavFeatures}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource IconSm}" Margin="2,0,10,0"/>
                            <TextBlock Text="{DynamicResource Settings_NavFeatures}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="updates" AutomationProperties.Name="{DynamicResource Settings_NavUpdates}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" Style="{StaticResource IconSm}" Margin="2,0,10,0"/>
                            <TextBlock Text="{DynamicResource Settings_NavUpdates}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="about" AutomationProperties.Name="{DynamicResource Settings_NavAbout}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource IconSm}" Margin="2,0,10,0"/>
                            <TextBlock Text="{DynamicResource Settings_NavAbout}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="18,10,18,18">
                    <TextBlock Text="{DynamicResource Settings_OnboardingBody}" Style="{StaticResource CardHint}"
                               FontSize="11"/>
                    <Button Content="{DynamicResource Settings_OnboardingButton}" Margin="0,8,0,0" Padding="10,7"
                            HorizontalAlignment="Stretch" FontSize="11.5" Click="OpenOnboarding_Click"
                            AutomationProperties.Name="{DynamicResource Settings_OnboardingButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= SAYFA ================= -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Divider}"
                    BorderThickness="0,0,0,1" Padding="28,20,28,16">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Style="{StaticResource DisplayTitle}" FontSize="22"
                               Text="{DynamicResource Settings_NavGeneral}"/>
                    <TextBlock x:Name="PageSubtitle" Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="12"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,20,22,24">
                <Grid>
                    <!-- ============ GENEL ============ -->
                    <StackPanel x:Name="PageGeneral">
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" FontSize="15"
                                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{DynamicResource Settings_Appearance}" Style="{StaticResource CardTitle}"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Settings_Theme}" Style="{StaticResource SettingRowLabel}"/>
                                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                              AutomationProperties.Name="{DynamicResource Settings_ThemeAutomation}">
                                        <ComboBoxItem Content="{DynamicResource Settings_ThemeDark}" Tag="dark"/>
                                        <ComboBoxItem Content="{DynamicResource Settings_ThemeLight}" Tag="light"/>
                                    </ComboBox>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Settings_Language}" Style="{StaticResource SettingRowLabel}"/>
                                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                              AutomationProperties.Name="{DynamicResource Settings_LanguageAutomation}">
                                        <ComboBoxItem Content="Türkçe" Tag="tr"/>
                                        <ComboBoxItem Content="English" Tag="en"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="15"
                                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{DynamicResource Settings_Startup}" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoStartCheck" Content="{DynamicResource Settings_AutoStart}" Margin="0,0,0,10"
                                          AutomationProperties.Name="{DynamicResource Settings_AutoStart}"/>
                                <CheckBox x:Name="StartMinimizedCheck" Content="{DynamicResource Settings_StartMinimized}" Margin="0,0,0,10"
                                          AutomationProperties.Name="{DynamicResource Settings_StartMinimized}"/>
                                <CheckBox x:Name="CloseToTrayCheck" Content="{DynamicResource Settings_CloseToTray}" Margin="0,0,0,10"
                                          AutomationProperties.Name="{DynamicResource Settings_CloseToTray}"/>
                                <CheckBox x:Name="CopyCheck" Content="{DynamicResource Settings_CopyOnImport}" Margin="0,0,0,2"
                                          AutomationProperties.Name="{DynamicResource Settings_CopyAutomation}"/>
                                <TextBlock Text="{DynamicResource Settings_CopyOnImportHint}" Style="{StaticResource CardHint}"
                                           Margin="27,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ SES ============ -->
                    <StackPanel x:Name="PageAudio" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="15"
                                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{DynamicResource Settings_RoutingTitle}" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Settings_RoutingHint}" Style="{StaticResource CardHint}"
                                           Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Settings_Output}" Style="{StaticResource SettingRowLabel}"
                                               ToolTip="{DynamicResource Settings_OutputTip}"/>
                                    <ComboBox x:Name="OutputCombo" Grid.Column="1" MinWidth="300" HorizontalAlignment="Left"
                                              ItemsSource="{Binding RenderDevices}" DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              AutomationProperties.Name="{DynamicResource Settings_OutputAutomation}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Settings_Microphone}" Style="{StaticResource SettingRowLabel}"/>
                                    <ComboBox x:Name="MicCombo" Grid.Column="1" MinWidth="300" HorizontalAlignment="Left"
                                              ItemsSource="{Binding CaptureDevices}" DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              AutomationProperties.Name="{DynamicResource Main_MicDevice}"/>
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Settings_Monitor}" Style="{StaticResource SettingRowLabel}"/>
                                    <ComboBox x:Name="MonitorCombo" Grid.Column="1" MinWidth="300" HorizontalAlignment="Left"
                                              ItemsSource="{Binding RenderDevices}" DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              AutomationProperties.Name="{DynamicResource Settings_MonitorAutomation}"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource Settings_AutoSetup}" Padding="14,8"
                                            Style="{StaticResource SoftButton}"
                                            Click="AutoSetup_Click"
                                            AutomationProperties.Name="{DynamicResource Settings_AutoSetupAutomation}"/>
                                    <Button Content="{DynamicResource Settings_OpenGuide}" Padding="14,8" Margin="8,0,0,0"
                                            Click="OpenGuide_Click"
                                            AutomationProperties.Name="{DynamicResource Settings_OpenGuide}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Windows cihaz adları -->
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE8D4;" Style="{StaticResource Icon}" FontSize="15"
                                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{DynamicResource Settings_DeviceNamesTitle}" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Settings_DeviceNamesBody}" Style="{StaticResource CardHint}"
                                           Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="RenameDevicesButton" Content="{DynamicResource Settings_DeviceNamesButton}"
                                            Padding="14,8" Style="{StaticResource AccentButton}"
                                            Click="RenameDevices_Click"
                                            AutomationProperties.Name="{DynamicResource Settings_DeviceNamesButton}"/>
                                </StackPanel>
                                <TextBlock x:Name="DeviceNameStatus" Style="{StaticResource CardHint}" Margin="0,10,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- ducking -->
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_Ducking}" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                                <CheckBox x:Name="DuckCheck" Content="{DynamicResource Settings_DuckEnable}" Margin="0,0,0,12"
                                          AutomationProperties.Name="{DynamicResource Settings_DuckingAutomation}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Settings_DuckRatio}" Style="{StaticResource SettingRowLabel}"
                                               Width="170"/>
                                    <Slider x:Name="DuckSlider" Width="220" Minimum="0" Maximum="1" TickFrequency="0.05"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="DuckSlider_ValueChanged"
                                            AutomationProperties.Name="{DynamicResource Settings_DuckAutomation}"/>
                                    <TextBlock x:Name="DuckLabel" Style="{StaticResource MonoValue}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Text="%25"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- voice changer -->
                        <Border x:Name="VoiceChangerPanel" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14"
                                Visibility="{Binding IsVoiceChangerEnabled, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE720;" Style="{StaticResource Icon}" FontSize="15"
                                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{DynamicResource Settings_VoiceChanger}" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Settings_VoiceChangerHint}" Style="{StaticResource CardHint}"
                                           Margin="0,0,0,12"/>
                                <CheckBox x:Name="VoiceEnabledCheck" Content="{DynamicResource Settings_VoiceChangerEnable}"
                                          Style="{StaticResource Switch}" Margin="0,0,0,14"
                                          AutomationProperties.Name="{DynamicResource Settings_VoiceChangerEnable}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{DynamicResource Settings_VoicePreset}" Style="{StaticResource SettingRowLabel}" Margin="0,0,0,12"/>
                                    <ComboBox x:Name="VoicePresetCombo" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                              Margin="0,0,0,12"
                                              SelectionChanged="VoicePreset_SelectionChanged"
                                              AutomationProperties.Name="{DynamicResource Settings_VoicePreset}">
                                        <ComboBoxItem Content="{DynamicResource VoicePreset_Natural}" Tag="Natural"/>
                                        <ComboBoxItem Content="{DynamicResource VoicePreset_Chipmunk}" Tag="Chipmunk"/>
                                        <ComboBoxItem Content="{DynamicResource VoicePreset_Deep}" Tag="Deep"/>
                                        <ComboBoxItem Content="{DynamicResource VoicePreset_Robot}" Tag="Robot"/>
                                        <ComboBoxItem Content="{DynamicResource VoicePreset_Echo}" Tag="Echo"/>
                                        <ComboBoxItem Content="{DynamicResource VoicePreset_Telephone}" Tag="Telephone"/>
                                        <ComboBoxItem Content="{DynamicResource VoicePreset_Custom}" Tag="Custom"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Text="{DynamicResource Settings_VoicePitch}" Style="{StaticResource SettingRowLabel}" Margin="0,0,0,12"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                                        <Slider x:Name="VoicePitchSlider" Width="220" Minimum="-12" Maximum="12" TickFrequency="1"
                                                IsSnapToTickEnabled="True" ValueChanged="VoicePitch_ValueChanged"/>
                                        <TextBlock x:Name="VoicePitchLabel" Style="{StaticResource MonoValue}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" Text="0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Text="{DynamicResource Settings_VoiceRobot}" Style="{StaticResource SettingRowLabel}" Margin="0,0,0,12"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                                        <Slider x:Name="VoiceRobotSlider" Width="220" Minimum="0" Maximum="1" TickFrequency="0.05"
                                                IsSnapToTickEnabled="True" ValueChanged="VoiceRobot_ValueChanged"/>
                                        <TextBlock x:Name="VoiceRobotLabel" Style="{StaticResource MonoValue}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" Text="0%"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="3" Text="{DynamicResource Settings_VoiceEcho}" Style="{StaticResource SettingRowLabel}" Margin="0,0,0,12"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                                        <Slider x:Name="VoiceEchoSlider" Width="220" Minimum="0" Maximum="1" TickFrequency="0.05"
                                                IsSnapToTickEnabled="True" ValueChanged="VoiceEcho_ValueChanged"/>
                                        <TextBlock x:Name="VoiceEchoLabel" Style="{StaticResource MonoValue}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" Text="0%"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="4" Text="{DynamicResource Settings_VoiceDelay}" Style="{StaticResource SettingRowLabel}" Margin="0,0,0,12"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                                        <Slider x:Name="VoiceDelaySlider" Width="220" Minimum="50" Maximum="500" TickFrequency="10"
                                                IsSnapToTickEnabled="True" ValueChanged="VoiceDelay_ValueChanged"/>
                                        <TextBlock x:Name="VoiceDelayLabel" Style="{StaticResource MonoValue}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" Text="160 ms"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <CheckBox x:Name="VoiceTelephoneCheck" Content="{DynamicResource Settings_VoiceTelephone}"
                                              VerticalAlignment="Center"/>
                                    <Button Content="{DynamicResource Settings_VoiceReset}" Padding="12,7" Margin="18,0,0,0"
                                            Click="VoiceReset_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- motor -->
                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_Engine}" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="{DynamicResource Settings_EngineLatency}" Style="{StaticResource SettingRowLabel}" Width="170"/>
                                    <Slider x:Name="LatencySlider" Width="220" Minimum="20" Maximum="200" TickFrequency="10"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="LatencySlider_ValueChanged"
                                            AutomationProperties.Name="{DynamicResource Settings_LatencyAutomation}"/>
                                    <TextBlock x:Name="LatencyLabel" Style="{StaticResource MonoValue}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Text="50 ms"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Settings_Cache}" Style="{StaticResource SettingRowLabel}" Width="170"/>
                                    <Slider x:Name="CacheSlider" Width="220" Minimum="32" Maximum="2048" TickFrequency="64"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="CacheSlider_ValueChanged"
                                            AutomationProperties.Name="{DynamicResource Settings_CacheAutomation}"/>
                                    <TextBlock x:Name="CacheLabel" Style="{StaticResource MonoValue}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Text="256 MB"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ DAVRANIŞ ============ -->
                    <StackPanel x:Name="PageBehavior" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_Behavior}" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Settings_DefaultBehavior}" Style="{StaticResource SettingRowLabel}"/>
                                    <ComboBox x:Name="BehaviorCombo" Grid.Column="1" Width="240" HorizontalAlignment="Left"
                                              AutomationProperties.Name="{DynamicResource Settings_BehaviorAutomation}">
                                        <ComboBoxItem Content="{DynamicResource Settings_BehaviorRestart}"/>
                                        <ComboBoxItem Content="{DynamicResource Settings_BehaviorOverlap}"/>
                                        <ComboBoxItem Content="{DynamicResource Settings_BehaviorToggle}"/>
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="SuppressCheck" Content="{DynamicResource Settings_SuppressHotkeys}"
                                          Margin="0,0,0,2"
                                          AutomationProperties.Name="{DynamicResource Settings_SuppressAutomation}"/>
                                <TextBlock Text="{DynamicResource Settings_SuppressHint}" Style="{StaticResource CardHint}"
                                           Margin="27,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE7C1;" Style="{StaticResource Icon}" FontSize="15"
                                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{DynamicResource Settings_RadialTitle}" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Settings_RadialHint}" Style="{StaticResource CardHint}"
                                           Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Settings_RadialHotkey}"
                                               Style="{StaticResource SettingRowLabel}" Width="190"/>
                                    <views:HotkeyBox x:Name="RadialHotkeyBox" Width="300" HorizontalAlignment="Left"
                                                     AutomationProperties.Name="{DynamicResource Settings_RadialHotkey}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_Hotkeys}" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Settings_StopAllHotkey}" Style="{StaticResource SettingRowLabel}" Width="190"/>
                                    <views:HotkeyBox x:Name="StopAllHotkeyBox" Width="300" HorizontalAlignment="Left"
                                                     AutomationProperties.Name="{DynamicResource Settings_StopAllHotkeyAutomation}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ ÖZELLİKLER ============ -->
                    <StackPanel x:Name="PageFeatures" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="15"
                                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{DynamicResource Settings_Features}" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Settings_FeaturesDescription}" Style="{StaticResource CardHint}"
                                           Margin="0,0,0,16"/>

                                <ItemsControl x:Name="FeaturesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Brush.Input}" CornerRadius="8"
                                                    Padding="14,11" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  AutomationProperties.Name="{Binding Name}"/>
                                                        <Border Grid.Column="1" Background="{DynamicResource Brush.AccentDim}"
                                                                CornerRadius="4" Padding="7,1" VerticalAlignment="Center"
                                                                Visibility="{Binding ShowAvailability, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding AvailabilityText}" FontSize="9"
                                                                       FontFamily="{DynamicResource Font.Mono}"
                                                                       Foreground="{DynamicResource Brush.Accent}"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Description}" FontSize="11.5" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource Brush.TextSecondary}" Margin="27,3,0,0"/>
                                                    <TextBlock Text="{Binding RestartHint}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource Brush.Warning}" Margin="27,3,0,0"
                                                               Visibility="{Binding ShowRestartHint, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ GÜNCELLEMELER ============ -->
                    <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="15"
                                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{DynamicResource Settings_Updates}" Style="{StaticResource CardTitle}"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Settings_CurrentVersion}" Style="{StaticResource SettingRowLabel}"/>
                                    <TextBlock x:Name="CurrentVersionText" Style="{StaticResource MonoValue}"
                                               VerticalAlignment="Center" Grid.Column="1"/>
                                </Grid>

                                <CheckBox x:Name="CheckUpdatesCheck" Content="{DynamicResource Settings_CheckForUpdates}"
                                          Margin="0,0,0,14"
                                          AutomationProperties.Name="{DynamicResource Settings_CheckForUpdates}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button x:Name="CheckUpdatesButton" Content="{DynamicResource Settings_CheckNow}"
                                            Padding="14,8" Click="CheckUpdates_Click"
                                            AutomationProperties.Name="{DynamicResource Settings_CheckNow}"/>
                                    <Button x:Name="DownloadUpdateButton" Content="{DynamicResource Settings_DownloadUpdate}"
                                            Padding="14,8" Margin="8,0,0,0" Visibility="Collapsed"
                                            Click="DownloadUpdate_Click"
                                            AutomationProperties.Name="{DynamicResource Settings_DownloadUpdate}"/>
                                </StackPanel>

                                <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ HAKKINDA ============ -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}" Padding="22">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource Brush.Accent}">
                                        <TextBlock Text="&#xE720;" Style="{StaticResource Icon}" FontSize="26"
                                                   Foreground="{DynamicResource Brush.OnAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="AboutVersionText" FontFamily="{DynamicResource Font.Display}"
                                                   FontSize="19" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource Settings_AboutTagline}" FontSize="12"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="AboutText" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                           TextWrapping="Wrap" LineHeight="19"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
