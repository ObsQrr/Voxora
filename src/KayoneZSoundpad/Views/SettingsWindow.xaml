<Window x:Class="KayoneZSoundpad.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KayoneZSoundpad.Views"
        Title="Ayarlar" Width="620" Height="660" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg}" WindowStyle="ToolWindow"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial" FontSize="13.5"
        ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="İptal" IsCancel="True" MinWidth="92"/>
                <Button Content="Kaydet" MinWidth="92" Margin="10,0,0,0" Style="{StaticResource AccentButton}" Click="Save_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18">
            <StackPanel>
                <!-- GENEL -->
                <TextBlock Text="GENEL" Style="{StaticResource SectionLabel}"/>
                <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,8,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Tema" Width="190" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ThemeCombo" Width="180" SelectedIndex="0">
                                <ComboBoxItem Content="Koyu"/>
                                <ComboBoxItem Content="Açık"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="AutoStartCheck" Content="Windows açılışında başlat" Margin="0,10,0,0"/>
                        <CheckBox x:Name="StartMinimizedCheck" Content="Sistem tepsisinde küçülerek başla" Margin="0,10,0,0"/>
                        <CheckBox x:Name="CloseToTrayCheck" Content="Kapatınca sistem tepsisinde kal" Margin="0,10,0,0"/>
                        <CheckBox x:Name="CopyCheck" Content="Eklenen sesleri kütüphane klasörüne kopyala (orijinal dosya silinse de çalışır)" Margin="0,10,0,0"/>
                        <CheckBox x:Name="RememberCatCheck" Content="Son kullanılan kategoriyi hatırla" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                            <TextBlock Text="Yeni seslerin varsayılan davranışı" Width="190" VerticalAlignment="Center"/>
                            <ComboBox x:Name="BehaviorCombo" Width="180" SelectedIndex="0">
                                <ComboBoxItem Content="Yeniden başlat"/>
                                <ComboBoxItem Content="Üstüne çal"/>
                                <ComboBoxItem Content="Çalıyorsa durdur"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SES -->
                <TextBlock Text="SES" Style="{StaticResource SectionLabel}"/>
                <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,8,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Motor gecikmesi" Width="190" VerticalAlignment="Center"
                                       ToolTip="Düşük = hızlı tepki; ses kopması olursa artır"/>
                            <Slider x:Name="LatencySlider" Width="130" Minimum="20" Maximum="200" Value="50"
                                    IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LatencyLabel" Style="{StaticResource Muted}" Margin="10,0,0,0" Text="50 ms"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                            <TextBlock Text="Bellek önbelleği (MB)" Width="190" VerticalAlignment="Center"
                                       ToolTip="Sık çalınan sesler bellekte tutulur; kapasite aşılırsa dosyadan akıtılır"/>
                            <Slider x:Name="CacheSlider" Width="130" Minimum="64" Maximum="1024" Value="256"
                                    IsSnapToTickEnabled="True" TickFrequency="32" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CacheLabel" Style="{StaticResource Muted}" Margin="10,0,0,0" Text="256 MB"/>
                        </StackPanel>
                        <CheckBox x:Name="DuckCheck" Content="Efekt çalarken mikrofonu kıs (ducking)" Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="22,8,0,2">
                            <TextBlock Text="Kısma oranı" Width="168" VerticalAlignment="Center"/>
                            <Slider x:Name="DuckSlider" Width="130" Minimum="0" Maximum="1" Value="0.25"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="DuckLabel" Style="{StaticResource Muted}" Margin="10,0,0,0" Text="%25"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- AYGITLAR -->
                <TextBlock Text="SES AYGITLARI" Style="{StaticResource SectionLabel}"/>
                <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,8,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Çıkış (oyun/Discord)" Width="190" VerticalAlignment="Center"
                                       ToolTip="VB-CABLE kuruluysa 'CABLE Input' seç; Discord'da mikrofonu 'CABLE Output' yap"/>
                            <ComboBox x:Name="OutputCombo" Width="300" ItemsSource="{Binding RenderDevices}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                            <TextBlock Text="Mikrofon" Width="190" VerticalAlignment="Center"/>
                            <ComboBox x:Name="MicCombo" Width="300" ItemsSource="{Binding CaptureDevices}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                            <TextBlock Text="Lokal monitör (hoparlör)" Width="190" VerticalAlignment="Center"
                                       ToolTip="Efektleri kendi kulağının da duyması için"/>
                            <ComboBox x:Name="MonitorCombo" Width="300" ItemsSource="{Binding RenderDevices}"/>
                        </StackPanel>
                        <CheckBox x:Name="MonitorCheck" Content="Efektleri lokalde de çal" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KISAYOLLAR -->
                <TextBlock Text="KISAYOLLAR" Style="{StaticResource SectionLabel}"/>
                <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,8,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tüm sesleri durdur" Width="190" VerticalAlignment="Center"/>
                            <views:HotkeyBox x:Name="StopAllHotkeyBox" Width="300" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <CheckBox x:Name="SuppressCheck" Content="Kısayol tuşlarını oyuna/app'e iletme (bastır)" Margin="0,12,0,0"/>
                        <TextBlock Text="Ses başına kısayolları kart üzerinde sağ tık → Düzenle'den atarsın." Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- SANAL MİKROFON REHBERİ -->
                <TextBlock Text="SANAL MİKROFON" Style="{StaticResource SectionLabel}"/>
                <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,8,0,8">
                    <StackPanel>
                        <TextBlock x:Name="CableStatusText" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource Brush.TextPrimary}">
                            Karşı tarafın efektleri duyması için sanal bir ses kablosu (VB-CABLE) gerekir:
                            <LineBreak/>
                            1. VB-CABLE'ı kur (ücretsiz) ve bilgisayarı yeniden başlat.
                            <LineBreak/>
                            2. Bu uygulamada Çıkış = <Bold>CABLE Input</Bold> seç.
                            <LineBreak/>
                            3. Discord / oyun ayarlarında mikrofon = <Bold>CABLE Output</Bold> seç.
                            <LineBreak/>
                            4. Bu uygulamada mikrofonunu aktif et: gerçek mikrofonun sesi efektlerle
                            karıştırılıp CABLE'a gönderilir.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Click="DownloadCable_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⬇" Margin="0,0,6,0"/>
                                    <TextBlock Text="VB-CABLE indir"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="AutoConfigBtn" Click="AutoConfig_Click" Margin="10,0,0,0"
                                    ToolTip="VB-CABLE kuruluysa çıkışı CABLE Input yapar, mikrofonu aktif eder">
                                <TextBlock Text="Otomatik ayarla"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="AboutText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Margin="0,4,0,18"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
