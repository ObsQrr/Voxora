<Window x:Class="KayoneZSoundpad.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Onboarding_WindowTitle}"
        Width="940" Height="660" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{DynamicResource Font.Body}" FontSize="13"
        ShowInTaskbar="False" ResizeMode="NoResize" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="Bullet" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Margin="20" CornerRadius="18" Background="{DynamicResource Brush.Bg}"
            BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= BAŞLIK ================= -->
            <Grid Margin="28,20,20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Brush.Accent}">
                        <Grid>
                            <Rectangle Width="2.5" Height="9" RadiusX="1.25" Fill="{DynamicResource Brush.OnAccent}"
                                       HorizontalAlignment="Center" Margin="-7,0,0,0"/>
                            <Rectangle Width="2.5" Height="15" RadiusX="1.25" Fill="{DynamicResource Brush.OnAccent}"
                                       HorizontalAlignment="Center"/>
                            <Rectangle Width="2.5" Height="6" RadiusX="1.25" Fill="{DynamicResource Brush.OnAccent}"
                                       HorizontalAlignment="Center" Margin="7,0,0,0"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="VOXORA" FontFamily="{DynamicResource Font.Display}" FontSize="15"
                               FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Border Width="1" Height="16" Background="{DynamicResource Brush.Divider}" Margin="12,0"/>
                    <TextBlock x:Name="StepLabel" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="CloseButton" HorizontalAlignment="Right" Style="{StaticResource IconButton}"
                        Click="Close_Click" ToolTip="{DynamicResource Common_Close}"
                        AutomationProperties.Name="{DynamicResource Common_Close}">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="14"/>
                </Button>
            </Grid>

            <!-- ================= İÇERİK ================= -->
            <Grid Grid.Row="1" Margin="28,12,28,0" ClipToBounds="True">

                <!-- 0 · HOŞ GELDİN -->
                <Grid x:Name="StepWelcome">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" MaxWidth="470" HorizontalAlignment="Left">
                        <TextBlock Text="{DynamicResource Onboarding_WelcomeTitle}" Style="{StaticResource DisplayTitle}"
                                   FontSize="34" TextWrapping="Wrap" LineHeight="40"/>
                        <TextBlock Text="{DynamicResource Onboarding_WelcomeBody}" TextWrapping="Wrap" FontSize="13.5"
                                   LineHeight="22" Margin="0,14,0,22" MaxWidth="440"
                                   Foreground="{DynamicResource Brush.TextSecondary}"/>

                        <StackPanel>
                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource Brush.AccentDim}">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource IconSm}" FontSize="11"
                                               Foreground="{DynamicResource Brush.Accent}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Onboarding_WelcomePoint1}" Style="{StaticResource Bullet}"/>
                            </Grid>
                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource Brush.AccentDim}">
                                    <TextBlock Text="&#xE774;" Style="{StaticResource IconSm}" FontSize="11"
                                               Foreground="{DynamicResource Brush.Accent}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Onboarding_WelcomePoint2}" Style="{StaticResource Bullet}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource Brush.AccentDim}">
                                    <TextBlock Text="&#xE720;" Style="{StaticResource IconSm}" FontSize="11"
                                               Foreground="{DynamicResource Brush.Accent}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Onboarding_WelcomePoint3}" Style="{StaticResource Bullet}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- dil -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22" VerticalAlignment="Center"
                            HorizontalAlignment="Stretch" Margin="20,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Onboarding_LanguageTitle}" FontFamily="{DynamicResource Font.Display}"
                                       FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource Onboarding_LanguageBody}" Style="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,6,0,16" LineHeight="19"/>

                            <Button x:Name="LangTrButton" Click="LangTr_Click" Padding="14,12" Margin="0,0,0,8"
                                    HorizontalContentAlignment="Left"
                                    AutomationProperties.Name="Türkçe">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="LangTrCheck" Text="&#xE73E;" Style="{StaticResource IconSm}"
                                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Türkçe" FontSize="13.5"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="LangEnButton" Click="LangEn_Click" Padding="14,12"
                                    HorizontalContentAlignment="Left"
                                    AutomationProperties.Name="English">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="LangEnCheck" Text="&#xE73E;" Style="{StaticResource IconSm}"
                                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0"/>
                                    <TextBlock Text="English" FontSize="13.5"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="TR · EN" Style="{StaticResource SectionLabel}" Margin="0,18,0,0"
                                       FontFamily="{DynamicResource Font.Mono}" FontSize="9"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 1 · TEMA -->
                <Grid x:Name="StepTheme" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Onboarding_ThemeTitle}" Style="{StaticResource DisplayTitle}" FontSize="28"/>
                        <TextBlock Text="{DynamicResource Onboarding_ThemeBody}" Style="{StaticResource Muted}"
                                   Margin="0,8,0,22"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- koyu kart -->
                            <Button x:Name="ThemeDarkCard" Grid.Column="0" Padding="0" BorderThickness="2"
                                    BorderBrush="{DynamicResource Brush.Accent}" Click="ThemeDark_Click"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <Border Background="#100E0C" CornerRadius="10" Padding="16" Height="220">
                                    <StackPanel>
                                        <Border Height="6" Width="60" CornerRadius="3" Background="#FF5C35"
                                                HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                        <Border Height="9" Width="130" CornerRadius="4" Background="#F4EDE3"
                                                HorizontalAlignment="Left" Margin="0,0,0,16"/>
                                        <Grid Height="58">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#1A1612" CornerRadius="6" BorderBrush="#2C251E" BorderThickness="1"/>
                                            <Border Grid.Column="2" Background="#1A1612" CornerRadius="6" BorderBrush="#2C251E" BorderThickness="1"/>
                                        </Grid>
                                        <Border Height="6" Width="160" CornerRadius="3" Background="#3A2119"
                                                HorizontalAlignment="Left" Margin="0,16,0,0"/>
                                        <TextBlock Text="{DynamicResource Onboarding_ThemeDark}" Foreground="#F4EDE3"
                                                   FontFamily="{DynamicResource Font.Display}" FontSize="16"
                                                   FontWeight="SemiBold" Margin="0,22,0,0"/>
                                        <TextBlock Text="{DynamicResource Onboarding_ThemeDarkHint}" Foreground="#B4A797"
                                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <!-- açık kart -->
                            <Button x:Name="ThemeLightCard" Grid.Column="2" Padding="0" BorderThickness="2"
                                    BorderBrush="{DynamicResource Brush.Divider}" Click="ThemeLight_Click"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <Border Background="#F1ECE3" CornerRadius="10" Padding="16" Height="220">
                                    <StackPanel>
                                        <Border Height="6" Width="60" CornerRadius="3" Background="#D8431A"
                                                HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                        <Border Height="9" Width="130" CornerRadius="4" Background="#191512"
                                                HorizontalAlignment="Left" Margin="0,0,0,16"/>
                                        <Grid Height="58">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#FCFAF5" CornerRadius="6" BorderBrush="#DFD6C8" BorderThickness="1"/>
                                            <Border Grid.Column="2" Background="#FCFAF5" CornerRadius="6" BorderBrush="#DFD6C8" BorderThickness="1"/>
                                        </Grid>
                                        <Border Height="6" Width="160" CornerRadius="3" Background="#F8DDD3"
                                                HorizontalAlignment="Left" Margin="0,16,0,0"/>
                                        <TextBlock Text="{DynamicResource Onboarding_ThemeLight}" Foreground="#191512"
                                                   FontFamily="{DynamicResource Font.Display}" FontSize="16"
                                                   FontWeight="SemiBold" Margin="0,22,0,0"/>
                                        <TextBlock Text="{DynamicResource Onboarding_ThemeLightHint}" Foreground="#574C41"
                                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 2 · SES -->
                <Grid x:Name="StepAudio" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Onboarding_AudioTitle}" Style="{StaticResource DisplayTitle}" FontSize="28"/>
                        <TextBlock Text="{DynamicResource Onboarding_AudioBody}" TextWrapping="Wrap" MaxWidth="700"
                                   HorizontalAlignment="Left"
                                   Margin="0,8,0,20" Foreground="{DynamicResource Brush.TextSecondary}" LineHeight="20"/>

                        <Border Style="{StaticResource Card}" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource Onboarding_OutputLabel}" Style="{StaticResource SectionLabel}"
                                               Margin="0,0,0,7"/>
                                    <ComboBox x:Name="OutputCombo" ItemsSource="{Binding RenderDevices}"
                                              DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                              SelectionChanged="Output_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource Onboarding_MicLabel}" Style="{StaticResource SectionLabel}"
                                               Margin="0,0,0,7"/>
                                    <ComboBox x:Name="MicCombo" ItemsSource="{Binding CaptureDevices}"
                                              DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                              SelectionChanged="Mic_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Onboarding_MonitorLabel}" Style="{StaticResource SectionLabel}"
                                               Margin="0,0,0,7"/>
                                    <CheckBox x:Name="MonitorSwitch" Style="{StaticResource Switch}"
                                              Content="{DynamicResource Main_LocalMonitor}"
                                              Checked="Monitor_Changed" Unchecked="Monitor_Changed"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource Onboarding_TestTone}" Padding="14,8"
                                                    Style="{StaticResource SoftButton}" Click="TestTone_Click"/>
                                            <Button Content="{DynamicResource Settings_AutoSetup}" Padding="13,8"
                                                    Margin="8,0,0,0" Click="AutoSetup_Click"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0"
                                                    VerticalAlignment="Center">
                                            <ProgressBar x:Name="ToneMeter" Width="150" Height="6" Minimum="0" Maximum="1"
                                                         Value="{Binding FxPeak, Mode=OneWay}"
                                                         Foreground="{DynamicResource Brush.Accent}"/>
                                            <TextBlock x:Name="TestToneStatus" Style="{StaticResource Muted}" Margin="12,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Onboarding_TestToneHint}" Style="{StaticResource CardHint}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 3 · CİHAZ ADI -->
                <Grid x:Name="StepDevice" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" MaxWidth="500" HorizontalAlignment="Left">
                        <TextBlock Text="{DynamicResource Onboarding_DeviceTitle}" Style="{StaticResource DisplayTitle}"
                                   FontSize="28" TextWrapping="Wrap"/>
                        <TextBlock Text="{DynamicResource Onboarding_DeviceBody}" TextWrapping="Wrap" LineHeight="21"
                                   Margin="0,10,0,20" Foreground="{DynamicResource Brush.TextSecondary}"/>

                        <Button Content="{DynamicResource Onboarding_RenameButton}" HorizontalAlignment="Left"
                                Padding="16,10" Style="{StaticResource AccentButton}" Click="Rename_Click"/>
                        <TextBlock Text="{DynamicResource Onboarding_RenameAdmin}" Style="{StaticResource CardHint}"
                                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="RenameStatus" Style="{StaticResource CardHint}" Margin="0,10,0,0"
                                   Visibility="Collapsed"/>
                        <Button Content="{DynamicResource Onboarding_DeviceLater}" HorizontalAlignment="Left"
                                Style="{StaticResource GhostButton}" Padding="10,6" Margin="0,8,0,0"
                                Click="SkipDevice_Click"/>
                    </StackPanel>

                    <!-- Discord mikrofon listesi önizlemesi -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="18,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="&#xE720;" Style="{StaticResource IconSm}"
                                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Onboarding_MockMicList}" Style="{StaticResource SectionLabel}" FontSize="9"/>
                            </StackPanel>

                            <Border Background="{DynamicResource Brush.SurfaceHover}" CornerRadius="7" Padding="10,9"
                                    BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Voxora Out Audio" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="&#xE73E;" Style="{StaticResource IconSm}"
                                               Foreground="{DynamicResource Brush.Success}"/>
                                </Grid>
                            </Border>

                            <Border CornerRadius="7" Padding="10,9" Margin="0,6,0,0" Background="Transparent">
                                <TextBlock Text="CABLE Output (VB-Audio Virtual Cable)" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           TextDecorations="Strikethrough"/>
                            </Border>

                            <Border Height="1" Background="{DynamicResource Brush.Divider}" Margin="0,12"/>
                            <TextBlock Text="VOIP" Style="{StaticResource SectionLabel}" FontSize="8.5"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 4 · HAZIR -->
                <Grid x:Name="StepReady" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                        <Border Width="68" Height="68" CornerRadius="20" Background="{DynamicResource Brush.AccentDim}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="30"
                                       Foreground="{DynamicResource Brush.Accent}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Onboarding_ReadyTitle}" Style="{StaticResource DisplayTitle}"
                                   FontSize="30" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                        <TextBlock Text="{DynamicResource Onboarding_ReadyBody}" TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,10,0,22" Foreground="{DynamicResource Brush.TextSecondary}" LineHeight="21"/>

                        <Border Style="{StaticResource Card}" Padding="16,12" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock x:Name="SummaryOutput" Style="{StaticResource MonoValue}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="SummaryMic" Style="{StaticResource MonoValue}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CTRL K" Style="{StaticResource SectionLabel}" FontSize="9"
                                                   Foreground="{DynamicResource Brush.Accent}"/>
                                        <TextBlock Text="{DynamicResource Onboarding_ShortcutSearch}" FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,3,8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Onboarding_HintClick}" Style="{StaticResource SectionLabel}" FontSize="9"
                                                   Foreground="{DynamicResource Brush.Accent}"/>
                                        <TextBlock Text="{DynamicResource Onboarding_ShortcutPlay}" FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,3,8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="STOP" Style="{StaticResource SectionLabel}" FontSize="9"
                                                   Foreground="{DynamicResource Brush.Accent}"/>
                                        <TextBlock Text="{DynamicResource Onboarding_ShortcutStop}" FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ================= ALT ================= -->
            <Grid Grid.Row="2" Margin="28,14,28,22">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" x:Name="Dots">
                    <Border Width="18" Height="5" CornerRadius="2.5" Background="{DynamicResource Brush.Accent}" Margin="0,0,6,0"/>
                    <Border Width="5" Height="5" CornerRadius="2.5" Background="{DynamicResource Brush.Divider}" Margin="0,0,6,0"/>
                    <Border Width="5" Height="5" CornerRadius="2.5" Background="{DynamicResource Brush.Divider}" Margin="0,0,6,0"/>
                    <Border Width="5" Height="5" CornerRadius="2.5" Background="{DynamicResource Brush.Divider}" Margin="0,0,6,0"/>
                    <Border Width="5" Height="5" CornerRadius="2.5" Background="{DynamicResource Brush.Divider}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="{DynamicResource Onboarding_Back}" MinWidth="104"
                            Padding="16,9" Margin="0,0,10,0" Visibility="Collapsed" Click="Back_Click"/>
                    <Button x:Name="NextButton" Content="{DynamicResource Onboarding_Next}" MinWidth="150"
                            Padding="18,9" Style="{StaticResource AccentButton}" Click="Next_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
