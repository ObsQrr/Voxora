<Window x:Class="KayoneZSoundpad.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KayoneZSoundpad.Views"
        Title="Voxora" Height="860" Width="1360" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        FontFamily="{DynamicResource Font.Body}"
        FontSize="13"
        UseLayoutRounding="True"
        AllowDrop="True"
        Drop="OnDrop" DragOver="OnDragOver">

    <Window.Resources>
        <ResourceDictionary>
            <views:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <views:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis"/>
            <views:MuteIconConverter x:Key="MuteIconConverter"/>
            <views:MuteTipConverter x:Key="MuteTipConverter"/>

            <Style x:Key="ActionGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,0,7,0"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            </Style>

            <!-- ============ SES KARTI ============ -->
            <DataTemplate x:Key="SoundCardTemplate">
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard x:Name="playBars">
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="bar1" Storyboard.TargetProperty="Height"
                                                     From="4" To="16" Duration="0:0:0.21" AutoReverse="True"/>
                                    <DoubleAnimation Storyboard.TargetName="bar2" Storyboard.TargetProperty="Height"
                                                     From="15" To="5" Duration="0:0:0.26" AutoReverse="True"/>
                                    <DoubleAnimation Storyboard.TargetName="bar3" Storyboard.TargetProperty="Height"
                                                     From="6" To="14" Duration="0:0:0.18" AutoReverse="True"/>
                                    <DoubleAnimation Storyboard.TargetName="bar4" Storyboard.TargetProperty="Height"
                                                     From="12" To="4" Duration="0:0:0.23" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="playBars"/>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </DataTemplate.Triggers>

                <Border x:Name="card" Width="236" Height="172" Margin="0,0,14,14"
                        BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="1"
                        CornerRadius="12" Cursor="Hand" Background="{DynamicResource Brush.Surface}"
                        SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick"
                                      Command="{Binding DataContext.PlayStopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}"/>
                    </Border.InputBindings>
                    <Border.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{DynamicResource Main_CardPlayStop}" Tag="play" Click="CardMenu_Click"/>
                            <MenuItem Header="{DynamicResource Main_CardMuteToggle}" Tag="mute" Click="CardMenu_Click"/>
                            <MenuItem Header="{DynamicResource Main_CardEdit}" Tag="edit" Click="CardMenu_Click"/>
                            <MenuItem Header="{DynamicResource Main_CardFavorite}" Tag="favorite" Click="CardMenu_Click"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource Main_CardRemove}" Tag="remove" Click="CardMenu_Click"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.30" Color="#000000"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.012" ScaleY="1.012"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                    <Setter Property="Background" Value="{DynamicResource Brush.Glow}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                    <Setter Property="Opacity" Value="0.55"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- çalma göstergesi -->
                        <Border x:Name="playRail" Width="4" CornerRadius="12,0,0,12"
                                Background="{DynamicResource Brush.Accent}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <Grid Grid.Column="1" Margin="14,11,13,11">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- üst: renk noktası + favori -->
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{Binding AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Icon}" FontSize="11" Margin="6,0,0,0"
                                               Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Warning}"
                                           Visibility="{Binding Favorite, Converter={StaticResource BoolToVis}}"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource Font.Body}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,6,0,4"
                                       ToolTip="{Binding Name}"/>

                            <!-- süre / kısayol / LED -->
                            <Grid Grid.Row="2" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DurationText}" FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="1" HorizontalAlignment="Left"
                                        Background="{DynamicResource Brush.AccentDim}" CornerRadius="4"
                                        Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HotkeyText, Converter={StaticResource NotEmptyToVis}}">
                                    <TextBlock Text="{Binding HotkeyText}" FontSize="10"
                                               FontFamily="{DynamicResource Font.Mono}"
                                               Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold"/>
                                </Border>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                            Height="18" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                                    <Rectangle x:Name="bar1" Width="3" Height="7" RadiusX="1.5" RadiusY="1.5"
                                               Fill="{DynamicResource Brush.Accent}" Margin="1,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="bar2" Width="3" Height="12" RadiusX="1.5" RadiusY="1.5"
                                               Fill="{DynamicResource Brush.Accent}" Margin="1,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="bar3" Width="3" Height="7" RadiusX="1.5" RadiusY="1.5"
                                               Fill="{DynamicResource Brush.Accent}" Margin="1,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="bar4" Width="3" Height="10" RadiusX="1.5" RadiusY="1.5"
                                               Fill="{DynamicResource Brush.Accent}" Margin="1,0" VerticalAlignment="Bottom"/>
                                </StackPanel>
                            </Grid>

                            <!-- alt: fader + mute -->
                            <Grid Grid.Row="3" Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="1.5" Height="20"
                                        Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalAlignment="Center" SmallChange="0.05" LargeChange="0.1"
                                        AutomationProperties.Name="{DynamicResource Card_Volume}"/>
                                <Button Grid.Column="1" Margin="8,0,0,0" Padding="6"
                                        Command="{Binding DataContext.ToggleMuteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource IconButton}" MinWidth="28" MinHeight="28"
                                        ToolTip="{Binding IsMuted, Converter={StaticResource MuteTipConverter}}"
                                        AutomationProperties.Name="{DynamicResource Main_MuteAutomation}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Text="{Binding IsMuted, Converter={StaticResource MuteIconConverter}}"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True" Background="{DynamicResource Brush.Bg}">

        <!-- ================= ÜST KOMUTA ÇUBUĞU ================= -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1"
                Padding="20,0" Height="66">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- marka -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Brush.Accent}">
                        <Grid>
                            <Rectangle Width="3" Height="10" RadiusX="1.5" Fill="{DynamicResource Brush.OnAccent}"
                                       HorizontalAlignment="Center" Margin="-8,0,0,0"/>
                            <Rectangle Width="3" Height="18" RadiusX="1.5" Fill="{DynamicResource Brush.OnAccent}"
                                       HorizontalAlignment="Center"/>
                            <Rectangle Width="3" Height="7" RadiusX="1.5" Fill="{DynamicResource Brush.OnAccent}"
                                       HorizontalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="VOXORA" FontFamily="{DynamicResource Font.Display}" FontSize="17"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <TextBlock Text="{DynamicResource Main_Tagline}" FontSize="9.5"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- arama -->
                <Border Grid.Column="1" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Input}" BorderBrush="{DynamicResource Brush.InputBorder}"
                        BorderThickness="1" CornerRadius="9" Height="38"
                        Visibility="{Binding IsSmartSearchEnabled, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="13,0,0,0"
                                   Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 VerticalContentAlignment="Center" Padding="9,0,4,0" MinHeight="34"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource Brush.TextPrimary}"
                                 FontSize="12.5" CaretBrush="{DynamicResource Brush.Accent}"
                                 AutomationProperties.Name="{DynamicResource Main_SearchPlaceholder}"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Main_SearchPlaceholder}" Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False"
                                   FontSize="12.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" CornerRadius="5"
                                Padding="6,2" Margin="0,0,9,0" VerticalAlignment="Center">
                            <TextBlock Text="CTRL K" FontFamily="{DynamicResource Font.Mono}" FontSize="9"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- eylemler -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,-6,0">
                    <Button Command="{Binding AddFilesCommand}" Style="{StaticResource AccentButton}"
                            Padding="15,9" AutomationProperties.Name="{DynamicResource Main_AddSoundFile}"
                            ToolTip="{DynamicResource Main_AddSoundTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Margin="0,0,7,0" Foreground="{DynamicResource Brush.OnAccent}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Main_AddSound}" Foreground="{DynamicResource Brush.OnAccent}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="22" Background="{DynamicResource Brush.Divider}" Margin="12,0"/>

                    <Button Command="{Binding AddFolderCommand}" Style="{StaticResource IconButton}"
                            AutomationProperties.Name="{DynamicResource Main_AddFolder}"
                            ToolTip="{DynamicResource Main_AddFolderTip}">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="15"/>
                    </Button>
                    <Button x:Name="ImportBtn" Click="ImportLibrary_Click" Style="{StaticResource IconButton}"
                            AutomationProperties.Name="{DynamicResource Main_Import}"
                            ToolTip="{DynamicResource Main_ImportTip}">
                        <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" FontSize="15"/>
                    </Button>
                    <Button x:Name="ExportBtn" Click="ExportLibrary_Click" Style="{StaticResource IconButton}"
                            AutomationProperties.Name="{DynamicResource Main_Export}"
                            ToolTip="{DynamicResource Main_ExportTip}">
                        <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="15"/>
                    </Button>
                    <Button x:Name="ExportSoundsBtn" Click="ExportSounds_Click" Style="{StaticResource IconButton}"
                            AutomationProperties.Name="{DynamicResource Main_ExportSounds}"
                            ToolTip="{DynamicResource Main_ExportSoundsTip}">
                        <TextBlock Text="&#xE7C3;" Style="{StaticResource Icon}" FontSize="15"/>
                    </Button>

                    <Border Width="1" Height="22" Background="{DynamicResource Brush.Divider}" Margin="12,0"/>

                    <Button x:Name="SettingsBtn" Click="OpenSettings_Click" Style="{StaticResource IconButton}"
                            AutomationProperties.Name="{DynamicResource Main_Settings}"
                            ToolTip="{DynamicResource Main_SettingsTip}">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= GÜNCELLEME ŞERİDİ ================= -->
        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="{DynamicResource Brush.AccentDim}"
                BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="0,0,0,1"
                Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0"
                           Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                <TextBlock x:Name="UpdateBannerText" Grid.Column="1" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" FontSize="12.5"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="{DynamicResource Settings_DownloadUpdate}" Padding="12,6"
                            Click="UpdateBannerDownload_Click"
                            AutomationProperties.Name="{DynamicResource Settings_DownloadUpdate}"/>
                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Padding="10,6" Margin="8,0,0,0"
                            Click="UpdateBannerClose_Click" ToolTip="{DynamicResource Common_Close}"
                            AutomationProperties.Name="{DynamicResource Common_Close}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MİKSER MASASI ================= -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Deck}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- MİKROFON -->
                <StackPanel Grid.Column="0" Margin="0,0,26,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource Main_Microphone}" Style="{StaticResource SectionLabel}"/>
                        <CheckBox x:Name="MicToggle" Style="{StaticResource Switch}"
                                  Content="{DynamicResource Main_MicActive}" Margin="14,0,0,0" FontSize="11.5"
                                  Checked="MicToggle_Changed" Unchecked="MicToggle_Changed"
                                  AutomationProperties.Name="{DynamicResource Main_MicActiveAutomation}"/>
                    </StackPanel>
                    <ComboBox x:Name="MicDeviceCombo" ItemsSource="{Binding CaptureDevices}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id"
                              MinWidth="240" SelectionChanged="MicDevice_SelectionChanged"
                              AutomationProperties.Name="{DynamicResource Main_MicDevice}"/>
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="MicVolumeSlider" Minimum="0" Maximum="1.5"
                                ValueChanged="MicVolume_Changed" Thumb.DragCompleted="MixerDragCompleted"
                                VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Main_MicVolume}"/>
                        <TextBlock x:Name="MicVolumeLabel" Grid.Column="1" Style="{StaticResource MonoValue}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" Text="100%"/>
                    </Grid>
                </StackPanel>

                <!-- EFEKTLER -->
                <StackPanel Grid.Column="1" Margin="0,0,26,0">
                    <TextBlock Text="{DynamicResource Main_EffectSounds}" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="FxVolumeSlider" Minimum="0" Maximum="1.5"
                                ValueChanged="FxVolume_Changed" Thumb.DragCompleted="MixerDragCompleted"
                                VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Main_FxVolume}"/>
                        <TextBlock x:Name="FxVolumeLabel" Grid.Column="1" Style="{StaticResource MonoValue}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" Text="100%"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="FX" Style="{StaticResource SectionLabel}" Width="30" FontSize="9"
                                   VerticalAlignment="Center"/>
                        <ProgressBar x:Name="FxMeter" Grid.Column="1" Height="6" Minimum="0" Maximum="1"
                                     Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OUT" Style="{StaticResource SectionLabel}" Width="30" FontSize="9"
                                   VerticalAlignment="Center"/>
                        <ProgressBar x:Name="OutMeter" Grid.Column="1" Height="6" Minimum="0" Maximum="1"
                                     Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- ÇIKIŞ -->
                <StackPanel Grid.Column="2" Margin="0,0,26,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource Main_OutputGameDiscord}" Style="{StaticResource SectionLabel}"/>
                        <CheckBox x:Name="MonitorToggle" Style="{StaticResource Switch}"
                                  Content="{DynamicResource Main_LocalMonitor}" Margin="14,0,0,0" FontSize="11.5"
                                  Checked="MonitorToggle_Changed" Unchecked="MonitorToggle_Changed"
                                  AutomationProperties.Name="{DynamicResource Main_MonitorAutomation}"/>
                    </StackPanel>
                    <ComboBox x:Name="OutputDeviceCombo" ItemsSource="{Binding RenderDevices}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id"
                              MinWidth="240" SelectionChanged="OutputDevice_SelectionChanged"
                              AutomationProperties.Name="{DynamicResource Main_OutputDevice}"/>
                    <TextBlock Text="{Binding CableStatusText}" FontSize="11" Margin="2,7,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- MASTER -->
                <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="132">
                    <TextBlock Text="{DynamicResource Main_Master}" Style="{StaticResource SectionLabel}"
                               HorizontalAlignment="Center" Margin="0,0,0,7"/>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Divider}"
                            BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding OutPeak, StringFormat={}{0:P0}}" FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}"/>
                            <TextBlock Text="PEAK" Style="{StaticResource SectionLabel}" FontSize="8.5"
                                       Margin="7,0,0,0" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="StopAllBtn" Command="{Binding StopAllCommand}"
                            Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{DynamicResource Main_StopAll}" Padding="16,9">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0"
                                       Foreground="{DynamicResource Brush.OnAccent}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Main_Stop}" Foreground="{DynamicResource Brush.OnAccent}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= SOL RAY ================= -->
        <Border DockPanel.Dock="Left" Width="250" Background="{DynamicResource Brush.Rail}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{DynamicResource Main_Library}" Style="{StaticResource SectionLabel}"
                           Margin="20,18,20,10"/>

                <Button Command="{Binding AddCategoryCommand}" Grid.Row="1"
                        Margin="14,0,14,8" Padding="10,7" FontSize="12"
                        HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Main_NewCategory}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,7,0"
                                   Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Main_AddCategory}"/>
                    </StackPanel>
                </Button>

                <ListBox Grid.Row="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                         Margin="10,2,10,10" x:Name="CategoryList"
                         ContextMenuOpening="CategoryList_ContextMenuOpening"
                         AutomationProperties.Name="{DynamicResource Main_CategoriesAutomation}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="{DynamicResource Category_Rename}" Click="RenameCategory_Click"/>
                                        <MenuItem Header="{DynamicResource Category_Delete}" Click="DeleteCategory_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" FontSize="12.5" Margin="4,0,0,0"/>
                                <Border Grid.Column="2" Background="{DynamicResource Brush.Input}" CornerRadius="9"
                                        MinWidth="22" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Count}" FontFamily="{DynamicResource Font.Mono}"
                                               FontSize="10" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button x:Name="CableStatusBtn" Grid.Row="3" Click="OpenCableGuide_Click"
                        Margin="14,0,14,16" Padding="12,10" HorizontalContentAlignment="Stretch"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Divider}"
                        AutomationProperties.Name="{DynamicResource Main_CategoryGuide}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="CableStatusDot" Width="7" Height="7" Margin="0,4,9,0"
                                 Fill="{DynamicResource Brush.Success}" VerticalAlignment="Top"/>
                        <TextBlock x:Name="CableStatusIcon" Text="" Visibility="Collapsed"/>
                        <TextBlock Grid.Column="1" Text="{Binding CableStatusText}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <!-- ================= KÜTÜPHANE ================= -->
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- bölüm başlığı -->
            <Grid Margin="24,20,24,6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedCategory.Name}" Style="{StaticResource DisplayTitle}" FontSize="21"/>
                    <StackPanel Orientation="Horizontal" Margin="1,3,0,0">
                        <TextBlock Text="{Binding SelectedCategory.Count}" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{DynamicResource Main_SongsUnit}" Style="{StaticResource SectionLabel}"
                                   Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenCableGuide_Click"
                        Style="{StaticResource SoftButton}" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,7,0"
                                   Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Main_RoutingGuide}" Foreground="{DynamicResource Brush.Accent}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,8,18,20">
                    <ItemsControl x:Name="SoundCards" ItemsSource="{Binding Sounds}"
                                  ItemTemplate="{StaticResource SoundCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="250" ItemHeight="186"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- boş durum -->
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="460" Visibility="Collapsed">
                    <Path Data="M2,34 L2,34 M10,34 L10,22 M18,34 L18,10 M26,34 L26,26 M34,34 L34,16 M42,34 L42,30"
                          Stroke="{DynamicResource Brush.Accent}" StrokeThickness="4" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" HorizontalAlignment="Center" Margin="0,0,0,26"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="2.4" ScaleY="1.6"/>
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock Text="{DynamicResource Main_EmptyTitle}" Style="{StaticResource DisplayTitle}"
                               FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Main_EmptyBody}" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,9,0,22" Foreground="{DynamicResource Brush.TextSecondary}"
                               FontSize="13" LineHeight="21"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding AddFilesCommand}" Style="{StaticResource AccentButton}"
                                Padding="18,9" AutomationProperties.Name="{DynamicResource Main_AddSoundFile}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0"
                                           Foreground="{DynamicResource Brush.OnAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Main_AddSoundFile}"
                                           Foreground="{DynamicResource Brush.OnAccent}"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OpenCableGuide_Click" Margin="10,0,0,0" Padding="18,9"
                                AutomationProperties.Name="{DynamicResource Main_MicGuide}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Main_MicGuide}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
