<Window x:Class="KayoneZSoundpad.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KayoneZSoundpad.Views"
        Title="Voxora" Height="820" Width="1320" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial"
        FontSize="13"
        AllowDrop="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/Theme.Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <views:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <views:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis"/>
            <views:MuteIconConverter x:Key="MuteIconConverter"/>
            <views:MuteTipConverter x:Key="MuteTipConverter"/>

            <!-- Sound Card DataTemplate -->
            <DataTemplate x:Key="SoundCardTemplate">
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="bar1" Storyboard.TargetProperty="Height"
                                                     From="3" To="14" Duration="0:0:0.2" AutoReverse="True"/>
                                    <DoubleAnimation Storyboard.TargetName="bar2" Storyboard.TargetProperty="Height"
                                                     From="12" To="4" Duration="0:0:0.25" AutoReverse="True"/>
                                    <DoubleAnimation Storyboard.TargetName="bar3" Storyboard.TargetProperty="Height"
                                                     From="5" To="13" Duration="0:0:0.18" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                    </DataTrigger>
                </DataTemplate.Triggers>

                <Border x:Name="card" Width="220" Height="158" Margin="0,0,12,12"
                        BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="1"
                        CornerRadius="8" Cursor="Hand" Background="{DynamicResource Brush.Surface}"
                        SnapsToDevicePixels="True">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick"
                                      Command="{Binding DataContext.PlayStopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}"/>
                    </Border.InputBindings>
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Çal / Durdur"
                                      Command="{Binding DataContext.PlayStopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}"/>
                            <MenuItem Header="Sesi Kıs / Aç"
                                      Command="{Binding DataContext.ToggleMuteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}"/>
                            <MenuItem Header="Düzenle..."
                                      Command="{Binding DataContext.EditSoundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}"/>
                            <MenuItem Header="Favori"
                                      Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}"/>
                            <Separator/>
                            <MenuItem Header="Kütüphaneden Kaldır"
                                      Command="{Binding DataContext.DeleteSoundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsMouseCaptured" Value="True">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
                                    <Setter Property="Opacity" Value="0.65"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Margin="14,12,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Üst: İkon + Favori -->
                        <Grid Grid.Row="0">
                            <TextBlock Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="★" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Warning}"
                                       HorizontalAlignment="Right"
                                       Visibility="{Binding Favorite, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <!-- İsim -->
                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,8,0,6"
                                   ToolTip="{Binding Name}"/>

                        <!-- Süre / Kısayol / Çalma göstergesi -->
                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DurationText}" Style="{StaticResource Muted}" FontSize="11"/>
                                <Border Background="{DynamicResource Brush.AccentDim}" CornerRadius="3"
                                        Padding="6,1" Margin="8,0,0,0"
                                        Visibility="{Binding HotkeyText, Converter={StaticResource NotEmptyToVis}}">
                                    <TextBlock Text="{Binding HotkeyText}" FontSize="10"
                                               Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                                <Rectangle x:Name="bar1" Width="3" Height="7" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{DynamicResource Brush.Accent}" Margin="1,0"/>
                                <Rectangle x:Name="bar2" Width="3" Height="12" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{DynamicResource Brush.Accent}" Margin="1,0"/>
                                <Rectangle x:Name="bar3" Width="3" Height="7" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{DynamicResource Brush.Accent}" Margin="1,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Ses Kontrolü -->
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔊" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource Brush.TextMuted}"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1.5"
                                    Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center" SmallChange="0.05" LargeChange="0.1"/>
                            <Button Grid.Column="2"
                                    Command="{Binding DataContext.ToggleMuteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" Padding="8,4" Margin="8,0,0,0"
                                    Content="{Binding IsMuted, Converter={StaticResource MuteIconConverter}}"
                                    FontSize="11" Foreground="{DynamicResource Brush.TextPrimary}"
                                    Background="Transparent" BorderBrush="{DynamicResource Brush.InputBorder}"
                                    ToolTip="{Binding IsMuted, Converter={StaticResource MuteTipConverter}}"
                                    AutomationProperties.Name="Sesi Kıs/Aç"/>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True" Background="{DynamicResource Brush.Bg}">
        <!-- ================= ÜST BAR ================= -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Brush.Accent}">
                        <TextBlock Text="🔊" FontSize="18" Foreground="{DynamicResource Brush.OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Voxora" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}"/>
                </StackPanel>

                <!-- Arama -->
                <Border Grid.Column="1" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Input}" BorderBrush="{DynamicResource Brush.InputBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="14" Margin="14,0,0,0"
                                   Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 VerticalContentAlignment="Center" Padding="8,0,0,0"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource Brush.TextPrimary}"
                                 FontSize="13" CaretBrush="{DynamicResource Brush.Accent}"/>
                        <TextBlock Grid.Column="1" Text="Ses ara..." Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False"
                                   FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Sağ Aksiyonlar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,-4,0">
                    <Button Command="{Binding AddFilesCommand}" Style="{StaticResource AccentButton}"
                            Padding="16,8" AutomationProperties.Name="Ses Dosyası Ekle">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource Brush.OnAccent}"/>
                            <TextBlock Text="Ses Ekle"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddFolderCommand}" Margin="8,0,0,0" Padding="12,8"
                            AutomationProperties.Name="Klasörden Ekle" ToolTip="Klasördeki tüm ses dosyalarını ekle">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Klasör"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ImportBtn" Click="ImportLibrary_Click" Margin="8,0,0,0" Padding="12,8"
                            AutomationProperties.Name="Kütüphaneyi İçe Aktar" ToolTip="Kütüphaneyi geri yükle (.zip)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📥" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="İçe Al"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportBtn" Click="ExportLibrary_Click" Margin="8,0,0,0" Padding="12,8"
                            AutomationProperties.Name="Kütüphaneyi Dışa Aktar" ToolTip="Kütüphaneyi yedekle (.zip)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📤" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Dışa Aktar"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsBtn" Click="OpenSettings_Click" Margin="8,0,0,0" Padding="12,8"
                            AutomationProperties.Name="Ayarlar" ToolTip="Ayarlar (Ctrl+,)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Ayarlar"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ALT MIKSER BAR ================= -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.8*"/>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="2.6*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mikrofon -->
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="MIKROFON" Style="{StaticResource SectionLabel}"/>
                        <CheckBox x:Name="MicToggle" Content="Aktif" Margin="12,0,0,0" FontSize="12"
                                  Checked="MicToggle_Changed" Unchecked="MicToggle_Changed"
                                  AutomationProperties.Name="Mikrofon Aktif"/>
                    </StackPanel>
                    <ComboBox x:Name="MicDeviceCombo" ItemsSource="{Binding CaptureDevices}"
                              SelectedValuePath="Id" SelectedValue="{Binding Settings.MicDeviceId, Mode=TwoWay}"
                              MinWidth="240" SelectionChanged="MicDevice_SelectionChanged"
                              AutomationProperties.Name="Mikrofon Aygıtı"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="🔊" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource Brush.TextMuted}"/>
                        <Slider x:Name="MicVolumeSlider" Width="180" Minimum="0" Maximum="1.5"
                                ValueChanged="MicVolume_Changed" Thumb.DragCompleted="MixerDragCompleted"
                                VerticalAlignment="Center" AutomationProperties.Name="Mikrofon Ses Seviyesi"/>
                        <TextBlock x:Name="MicVolumeLabel" Style="{StaticResource Muted}" Margin="10,0,0,0" Text="100%"/>
                    </StackPanel>
                </StackPanel>

                <!-- Efekt Sesleri -->
                <StackPanel Grid.Column="1" Margin="0,0,24,0">
                    <TextBlock Text="EFEKT SESLERİ" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <Slider x:Name="FxVolumeSlider" Width="180" Minimum="0" Maximum="1.5"
                                ValueChanged="FxVolume_Changed" Thumb.DragCompleted="MixerDragCompleted"
                                VerticalAlignment="Center" AutomationProperties.Name="Efekt Ses Seviyesi"/>
                        <TextBlock x:Name="FxVolumeLabel" Style="{StaticResource Muted}" Margin="10,0,0,0" Text="100%"/>
                    </StackPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="EFEKT" Style="{StaticResource Muted}" Width="44" FontSize="10.5"/>
                        <ProgressBar x:Name="FxMeter" Grid.Column="1" Height="5" Minimum="0" Maximum="1"
                                     Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ÇIKIŞ" Style="{StaticResource Muted}" Width="44" FontSize="10.5"/>
                        <ProgressBar x:Name="OutMeter" Grid.Column="1" Height="5" Minimum="0" Maximum="1"
                                     Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Çıkış (Oyun/Discord) -->
                <StackPanel Grid.Column="2" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="ÇIKIŞ (OYUN / DISCORD)" Style="{StaticResource SectionLabel}"/>
                        <CheckBox x:Name="MonitorToggle" Content="Lokal Dinle" Margin="12,0,0,0" FontSize="12"
                                  Checked="MonitorToggle_Changed" Unchecked="MonitorToggle_Changed"
                                  AutomationProperties.Name="Lokal Dinleme"/>
                    </StackPanel>
                    <ComboBox x:Name="OutputDeviceCombo" ItemsSource="{Binding RenderDevices}"
                              SelectedValuePath="Id" SelectedValue="{Binding Settings.MonitorDeviceId, Mode=TwoWay}"
                              MinWidth="240" SelectionChanged="OutputDevice_SelectionChanged"
                              AutomationProperties.Name="Çıkış Aygıtı"/>
                </StackPanel>

                <!-- Durdur -->
                <Button Grid.Column="3" x:Name="StopAllBtn" Command="{Binding StopAllCommand}"
                        Style="{StaticResource DangerButton}" VerticalAlignment="Center"
                        AutomationProperties.Name="Tüm Sesleri Durdur" Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏹" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource Brush.OnAccent}"/>
                        <TextBlock Text="Durdur"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ================= SOL KENAR ÇUBUĞU (Kategoriler) ================= -->
        <Border DockPanel.Dock="Left" Width="240" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="KATEGORİLER" Style="{StaticResource SectionLabel}"
                           Margin="18,18,18,10"/>

                <Button Command="{Binding AddCategoryCommand}"
                        Margin="14,0,14,10" Padding="10,8" FontSize="12.5"
                        HorizontalAlignment="Stretch" AutomationProperties.Name="Yeni Kategori">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="➕" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Kategori Ekle"/>
                    </StackPanel>
                </Button>

                <!-- VB-CABLE Durumu (altta) -->
                <Button x:Name="CableStatusBtn" Click="OpenCableGuide_Click"
                        Margin="14,0,14,16" Padding="12,10" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderBrush="{DynamicResource Brush.Divider}"
                        AutomationProperties.Name="Mikrofon Yönlendirme Rehberi"
                        VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CableStatusIcon" Text="ℹ" FontSize="14" Margin="0,0,8,0"
                                   Foreground="{DynamicResource Brush.Success}"/>
                        <TextBlock Text="{Binding CableStatusText}" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                    </StackPanel>
                </Button>

                <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                         Margin="12,0,12,12" x:Name="CategoryList"
                         AutomationProperties.Name="Ses Kategorileri">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" FontSize="13.5"/>
                                <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource Muted}"
                                           FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- ================= İÇERİK ALANI ================= -->
        <Grid Background="Transparent">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18,16,18">
                <ItemsControl x:Name="SoundCards" ItemsSource="{Binding Sounds}"
                              ItemTemplate="{StaticResource SoundCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="220" ItemHeight="158"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Boş Durum -->
            <Border x:Name="EmptyState" Background="Transparent"
                    Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="480">
                <StackPanel>
                    <Border Width="88" Height="88" CornerRadius="16" Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="1"
                            HorizontalAlignment="Center" Margin="0,0,0,22">
                        <TextBlock Text="🔊" FontSize="36" Foreground="{DynamicResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Henüz Ses Efekti Yok" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="MP3, WAV, OGG veya FLAC dosyalarını buraya sürükleyip bırakın. &#x0a;Karşı tarafın duyması için Mikrofon Rehberi'ni açın."
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,28"
                               Foreground="{DynamicResource Brush.TextSecondary}" FontSize="14" LineHeight="22"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding AddFilesCommand}" Style="{StaticResource AccentButton}"
                                Padding="20,10" AutomationProperties.Name="Ses Dosyası Ekle">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource Brush.OnAccent}"/>
                                <TextBlock Text="Ses Dosyası Ekle"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OpenCableGuide_Click" Margin="12,0,0,0" Padding="20,10"
                                AutomationProperties.Name="Mikrofon Rehberi">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎙" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Mikrofon Rehberi"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>