<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ VOXORA 2.0 — DARK: "NIGHT SHIFT" ============
         Sıcak isli zemin, krem tipografi, sinyal turuncusu ve VU yeşili.
         Renk anahtarları Theme.Light.xaml ile birebir aynıdır. -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Theme.Base.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Color x:Key="Color.Accent">#FF5C35</Color>
    <Color x:Key="Color.AccentHover">#FF7D5C</Color>
    <Color x:Key="Color.AccentDim">#3A2119</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="#0E0C0A"/>
    <SolidColorBrush x:Key="Brush.Panel" Color="#14110E"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#1A1612"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#241F19"/>
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#2C251E"/>
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#302820"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#2C251E"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F4EDE3"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#B4A797"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#7F7263"/>
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="#FF5C35"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF7D5C"/>
    <SolidColorBrush x:Key="Brush.AccentDim" Color="#3A2119"/>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#E2574C"/>
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#EC7168"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#8FD46B"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#E5B45C"/>

    <SolidColorBrush x:Key="Brush.Input" Color="#16120F"/>
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#3A3128"/>
    <SolidColorBrush x:Key="Brush.InputBorderFocus" Color="#FF5C35"/>
    <SolidColorBrush x:Key="Brush.InputBorderHover" Color="#4B3F33"/>
    <SolidColorBrush x:Key="Brush.InputDisabled" Color="#12100D"/>

    <SolidColorBrush x:Key="Brush.FocusRing" Color="#FF5C35"/>
    <SolidColorBrush x:Key="Brush.ScrollbarThumb" Color="#3A3128"/>
    <SolidColorBrush x:Key="Brush.ScrollbarThumbHover" Color="#FF5C35"/>

    <!-- Konsol yüzeyleri -->
    <SolidColorBrush x:Key="Brush.Deck" Color="#12100D"/>
    <SolidColorBrush x:Key="Brush.Rail" Color="#17130F"/>
    <SolidColorBrush x:Key="Brush.Glow" Color="#2A1209"/>
</ResourceDictionary>
