<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ VOXORA 2.0 — LIGHT: "DAYLIGHT DESK" ============
         Sıcak kâğıt zemin, mürekkep tipografi, aynı sinyal turuncusu.
         Renk anahtarları Theme.Dark.xaml ile birebir aynıdır. -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Theme.Base.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Color x:Key="Color.Accent">#D8431A</Color>
    <Color x:Key="Color.AccentHover">#EE5C33</Color>
    <Color x:Key="Color.AccentDim">#F8DDD3</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="#F1ECE3"/>
    <SolidColorBrush x:Key="Brush.Panel" Color="#F8F4ED"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FCFAF5"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#EDE5D8"/>
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#DCD2C3"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#DFD6C8"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#191512"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#574C41"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#8B7D6C"/>
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="#D8431A"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#EE5C33"/>
    <SolidColorBrush x:Key="Brush.AccentDim" Color="#F8DDD3"/>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#B3382E"/>
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#C74C42"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#3F7A34"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#9A6B12"/>

    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#D2C7B7"/>
    <SolidColorBrush x:Key="Brush.InputBorderFocus" Color="#D8431A"/>
    <SolidColorBrush x:Key="Brush.InputBorderHover" Color="#BCAF9C"/>
    <SolidColorBrush x:Key="Brush.InputDisabled" Color="#EFEAE1"/>

    <SolidColorBrush x:Key="Brush.FocusRing" Color="#D8431A"/>
    <SolidColorBrush x:Key="Brush.ScrollbarThumb" Color="#D2C7B7"/>
    <SolidColorBrush x:Key="Brush.ScrollbarThumbHover" Color="#D8431A"/>

    <!-- Konsol yüzeyleri -->
    <SolidColorBrush x:Key="Brush.Deck" Color="#F7F2EA"/>
    <SolidColorBrush x:Key="Brush.Rail" Color="#F7F2EA"/>
    <SolidColorBrush x:Key="Brush.Glow" Color="#FBE3DA"/>
</ResourceDictionary>
